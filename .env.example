## Databricks Genie MCP integration
# Put your Genie MCP server URL here (your Genie Space MCP server).
GENIE_MCP_SERVER_URL="https://dbc-b1b2f91a-d102.cloud.databricks.com/api/2.0/mcp/genie/<space_id>"

# Optional: default Databricks CLI profile for auth (uses ~/.databrickscfg)
DATABRICKS_CONFIG_PROFILE="llmops-course"

# Optional: PAT-based auth (use instead of profile if needed)
# DATABRICKS_HOST="https://dbc-b1b2f91a-d102.cloud.databricks.com"
# DATABRICKS_TOKEN="dapi..."
